# Copie para ~/.oci/vm.env do usuario ocibot e rode: chmod 600 ~/.oci/vm.env
# Os IDs saem dos comandos da Etapa 6.3 do guia.

COMPARTMENT=ocid1.tenancy.oc1..SEU_TENANCY
AD=XXXX:SA-SAOPAULO-1-AD-1
SUBNET=ocid1.subnet.oc1.sa-saopaulo-1.SUA_SUBREDE_PUBLICA
IMAGE=ocid1.image.oc1.sa-saopaulo-1.SUA_IMAGEM_UBUNTU_AARCH64
NOME=vps-principal
OCPUS=1
MEMORIA=6
DISCO=100
INTERVALO=150

# --- Avisos (opcional; preencha um ou mais canais) ---

# WhatsApp via Evolution API v2
#EVO_URL=https://sua-evolution-api.com.br
#EVO_INSTANCIA=nome-da-instancia
#EVO_APIKEY=sua-api-key
#EVO_NUMERO=5521999999999

# Telegram (mande uma mensagem ao bot antes de testar)
#TELEGRAM_TOKEN=123456:ABC-seu-token
#TELEGRAM_CHAT=seu-chat-id

# Webhook generico (n8n, Make): recebe POST {"mensagem": "..."}
#WEBHOOK_URL=https://seu-n8n.com.br/webhook/oracle-vm
